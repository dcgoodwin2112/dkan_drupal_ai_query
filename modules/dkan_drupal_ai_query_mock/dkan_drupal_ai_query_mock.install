<?php

/**
 * @file
 * Install hooks for dkan_drupal_ai_query_mock.
 */

/**
 * Implements hook_install().
 *
 * If the parent module's curated allow-list is set, append the mock model so
 * it shows up in the widget dropdown. Empty allow-list means "show every
 * usable provider" — nothing to do.
 */
function dkan_drupal_ai_query_mock_install(): void {
  $config = \Drupal::configFactory()->getEditable('dkan_drupal_ai_query.settings');
  $allowed = (array) ($config->get('allowed_models') ?? []);
  if ($allowed === [] || in_array('dkan_aiq_mock__scripted', $allowed, TRUE)) {
    return;
  }
  $allowed[] = 'dkan_aiq_mock__scripted';
  $config->set('allowed_models', $allowed)->save();
  \Drupal::logger('dkan_drupal_ai_query_mock')
    ->notice('Added dkan_aiq_mock__scripted to dkan_drupal_ai_query.settings:allowed_models so the mock is selectable in the widget dropdown.');
  \Drupal::messenger()->addStatus(t(
    'DKAN AI Query Mock installed. Run <code>drush dkan-aiq-mock:fixture:install</code> to seed the National Parks fixture so the shipped scenarios have data to query.',
  ));
}

/**
 * Implements hook_uninstall().
 *
 * Removes the mock from the allow-list and clears the picker / kill-switch
 * state keys so a later real-provider install starts clean.
 */
function dkan_drupal_ai_query_mock_uninstall(): void {
  $config = \Drupal::configFactory()->getEditable('dkan_drupal_ai_query.settings');
  $allowed = (array) ($config->get('allowed_models') ?? []);
  $filtered = array_values(array_filter($allowed, static fn ($m) => $m !== 'dkan_aiq_mock__scripted'));
  if ($filtered !== $allowed) {
    $config->set('allowed_models', $filtered)->save();
  }
  $state = \Drupal::state();
  $state->delete('dkan_drupal_ai_query_mock.active_scenario');
  $state->delete('dkan_drupal_ai_query_mock.force_active');
  $state->delete('dkan_drupal_ai_query_mock.turn_delay_ms');
  $state->delete('dkan_drupal_ai_query_mock.fixture_resource_id');
  \Drupal::messenger()->addStatus(t(
    'DKAN AI Query Mock uninstalled. If you previously installed the parks fixture, you may want to run <code>drush dkan-aiq-mock:fixture:remove</code> first to drop the dataset and datastore table; uninstalling the module alone leaves them in place.',
  ));
}
