<?php

/**
 * @file
 * Hook implementations for dkan_ai_query.
 */

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function dkan_ai_query_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.dkan_ai_query':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('DKAN AI Query adds a natural-language query widget for <a href=":dkan">DKAN</a> datasets, built on the <a href=":ai_agents">AI Agents</a> framework. Visitors ask questions in plain language; an AI agent translates them into datastore queries and answers with the results, including provenance for every figure.', [
        ':dkan' => 'https://www.drupal.org/project/dkan',
        ':ai_agents' => 'https://www.drupal.org/project/ai_agents',
      ]) . '</p>';
      $output .= '<h3>' . t('Requirements') . '</h3>';
      $output .= '<p>' . t('An AI provider module with a configured API key is required at runtime — for example <a href=":anthropic">ai_provider_anthropic</a> or <a href=":openai">ai_provider_openai</a>.', [
        ':anthropic' => 'https://www.drupal.org/project/ai_provider_anthropic',
        ':openai' => 'https://www.drupal.org/project/ai_provider_openai',
      ]) . '</p>';
      $output .= '<h3>' . t('Access control and configuration') . '</h3>';
      $output .= '<p>' . t('Querying requires the <em>Use the DKAN AI query widget</em> permission; saved conversations and administration each have their own permissions. Pick the provider/model and place the widget from the <a href=":settings">AI Query settings</a> page. See the module README for the API endpoints, operational notes, and the system-prompt versioning workflow.', [
        ':settings' => Url::fromRoute('dkan_ai_query.settings_form')->toString(),
      ]) . '</p>';
      return $output;

    case 'dkan_ai_query.settings_form':
      return '<p>' . t('Configure the AI provider and model, widget placement, and conversation retention for the DKAN AI query widget.') . '</p>';
  }
}

/**
 * Implements hook_modules_installed().
 *
 * Auto-wires AI provider modules to our migrated Key entities the moment they
 * become available. Idempotent and non-destructive: only fills in api_key when
 * the provider's slot is empty, never overwrites an operator's choice. Skipped
 * during config sync — imported config is the source of truth there.
 */
function dkan_ai_query_modules_installed(array $modules, bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  $map = [
    'ai_provider_anthropic' => [
      'cfg' => 'ai_provider_anthropic.settings',
      'key' => 'dkan_anthropic',
    ],
    'ai_provider_openai' => [
      'cfg' => 'ai_provider_openai.settings',
      'key' => 'dkan_openai',
    ],
  ];
  $keyStorage = \Drupal::entityTypeManager()->getStorage('key');
  $cfgFactory = \Drupal::configFactory();
  foreach ($modules as $module) {
    if (!isset($map[$module])) {
      continue;
    }
    $info = $map[$module];
    if (!$keyStorage->load($info['key'])) {
      continue;
    }
    $cfg = $cfgFactory->getEditable($info['cfg']);
    if ($cfg->get('api_key')) {
      continue;
    }
    $cfg->set('api_key', $info['key'])->save();
    \Drupal::logger('dkan_ai_query')->notice(
      'Wired @module to Key entity @key.',
      ['@module' => $module, '@key' => $info['key']]
    );
  }
}

/**
 * Implements hook_cron().
 *
 * Purges saved conversations older than `conversation_retention_days`. A value
 * of 0 (the default) disables the purge. Pinned conversations are preserved.
 */
function dkan_ai_query_cron(): void {
  $days = (int) (\Drupal::config('dkan_ai_query.settings')->get('conversation_retention_days') ?? 0);
  if ($days <= 0) {
    return;
  }
  $cutoff = \Drupal::time()->getRequestTime() - ($days * 86400);
  $deleted = \Drupal::service('dkan_ai_query.conversation_storage')->purgeOlderThan($cutoff);
  if ($deleted > 0) {
    \Drupal::logger('dkan_ai_query')->notice(
      'Purged @n conversations older than @d days.',
      ['@n' => $deleted, '@d' => $days]
    );
  }
}

/**
 * Implements hook_form_alter().
 *
 * Note on the ai_agent edit form when it's the dkan_data_query agent that the
 * default prompt is sourced from a markdown file in this module, not from this
 * form's text area.
 */
function dkan_ai_query_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if ($form_id !== 'ai_agent_edit_form' && $form_id !== 'ai_agent_add_form') {
    return;
  }
  $entity = $form_state->getFormObject() instanceof
  EntityFormInterface ? $form_state->getFormObject()->getEntity()
    : NULL;
  if ($entity === NULL || $entity->id() !== 'dkan_data_query') {
    return;
  }
  if (!isset($form['system_prompt'])) {
    return;
  }
  $form['system_prompt']['#description'] = ($form['system_prompt']['#description'] ?? '')
    . ' <strong>This agent\'s default prompt is sourced from <code>prompts/query_system_prompt.v{N}.md</code> in the dkan_ai_query module.</strong>'
    . ' Edits saved here override the default until the next prompt sync (drush updb or drush dkan-aiq:sync-prompt).'
    . ' Run drush cex first if you want to keep your edits.';
}

/**
 * Implements hook_theme().
 */
function dkan_ai_query_theme($existing, $type, $theme, $path) {
  return [
    'dkan_ai_query_widget' => [
      'variables' => [
        'dataset_id' => '',
      ],
      'template' => 'dkan-ai-query-widget',
    ],
  ];
}
