<?php

/**
 * @file
 * Install, update, and uninstall hooks for dkan_drupal_ai_query.
 */

use Drupal\dkan_drupal_ai_query\Entity\Conversation;
use Drupal\dkan_drupal_ai_query\Entity\Message;

/**
 * Implements hook_install().
 */
function dkan_drupal_ai_query_install(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  foreach (['dkan_aiq_conversation' => Conversation::class, 'dkan_aiq_message' => Message::class] as $eid => $class) {
    if ($update_manager->getEntityType($eid)) {
      continue;
    }
    $type = \Drupal::entityTypeManager()->getDefinition($eid);
    $update_manager->installEntityType($type);
  }
}

/**
 * Implements hook_uninstall().
 *
 * Removes the Conversation and Message tables. Does NOT delete Key entities
 * configured for AI providers — they outlive this module.
 */
function dkan_drupal_ai_query_uninstall(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  foreach (['dkan_aiq_message', 'dkan_aiq_conversation'] as $eid) {
    if ($type = $update_manager->getEntityType($eid)) {
      $update_manager->uninstallEntityType($type);
    }
  }
}

/**
 * Clear stale default_model values that pre-date the dynamic provider list.
 *
 * The dropdown previously stored bare model ids (e.g. "claude-haiku-4-5-…")
 * which no longer match — options are now "<provider>__<model>". Clear any
 * legacy value so the form reverts to "Use global default" and the operator
 * can re-pick from the live, accurate list.
 */
function dkan_drupal_ai_query_update_10003(): string {
  $config = \Drupal::configFactory()->getEditable('dkan_drupal_ai_query.settings');
  $current = (string) ($config->get('default_model') ?? '');
  if ($current === '' || str_contains($current, '__')) {
    return 'No legacy default_model to clear.';
  }
  $config->set('default_model', '')->save();
  return sprintf('Cleared legacy default_model "%s"; pick a new value at /admin/config/dkan/ai-query.', $current);
}

/**
 * Register the compute_stats tool on the dkan_data_query agent.
 */
function dkan_drupal_ai_query_update_10004(): string {
  $config = \Drupal::configFactory()->getEditable('ai_agents.ai_agent.dkan_data_query');
  $tools = $config->get('tools') ?? [];
  $key = 'dkan_drupal_ai_query:compute_stats';
  if (array_key_exists($key, $tools)) {
    return 'compute_stats already registered.';
  }
  $tools[$key] = TRUE;
  $config->set('tools', $tools)->save();
  return 'Registered compute_stats tool on dkan_data_query agent.';
}

/**
 * Register the get_data_dictionary tool on the dkan_data_query agent.
 *
 * The plugin and the v3/v4 prompt both reference this tool, but it was
 * never added to the agent's tools map when data dictionaries were wired
 * in — so the agent could not actually invoke it.
 */
function dkan_drupal_ai_query_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('ai_agents.ai_agent.dkan_data_query');
  $tools = $config->get('tools') ?? [];
  $key = 'dkan_drupal_ai_query:get_data_dictionary';
  if (array_key_exists($key, $tools)) {
    return 'get_data_dictionary already registered.';
  }
  $tools[$key] = TRUE;
  $config->set('tools', $tools)->save();
  return 'Registered get_data_dictionary tool on dkan_data_query agent.';
}
