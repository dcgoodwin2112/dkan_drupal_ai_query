<div class="dkan-aiq-widget" data-dataset-id="{{ dataset_id }}">
  <div class="dkan-aiq-sidebar" hidden>
    <div class="dkan-aiq-sidebar-header">
      <span class="dkan-aiq-sidebar-header-title">History</span>
      <button type="button"
              class="dkan-aiq-sidebar-toggle"
              aria-label="Collapse history sidebar"
              aria-expanded="true">
        <svg class="dkan-aiq-sidebar-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
    </div>
    <button type="button"
            class="dkan-aiq-sidebar-rail-summary"
            data-count="0"
            aria-label="Expand history sidebar">
      <svg class="dkan-aiq-sidebar-rail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="dkan-aiq-sidebar-rail-count">0</span>
    </button>
    <div class="dkan-aiq-sidebar-search">
      <input type="text" class="dkan-aiq-sidebar-search-input" placeholder="Search conversations..." />
    </div>
    <div class="dkan-aiq-sidebar-list"></div>
    <div class="dkan-aiq-sidebar-footer"></div>
  </div>

  <div class="dkan-aiq-main">
  <div class="dkan-aiq-thread-header" hidden>
    <button type="button" class="dkan-aiq-new-conversation">New conversation</button>
  </div>
  <div class="dkan-aiq-thread"></div>

  <div class="dkan-aiq-status" hidden>
    <span class="dkan-aiq-spinner"></span>
    <span class="dkan-aiq-status-text"></span>
  </div>

  <div class="dkan-aiq-error" hidden></div>

  <form class="dkan-aiq-form">
    <div class="dkan-aiq-dataset-selector"{% if dataset_id %} hidden{% endif %}>
      <label for="dkan-aiq-dataset-select" class="dkan-aiq-dataset-label">Dataset</label>
      <select id="dkan-aiq-dataset-select" class="dkan-aiq-dataset-select">
        <option value="">All datasets (AI will find the right one)</option>
      </select>
    </div>
    <div class="dkan-aiq-input-wrapper">
      <label for="dkan-aiq-input" class="visually-hidden">Ask a question about this dataset</label>
      <textarea
        id="dkan-aiq-input"
        class="dkan-aiq-input"
        placeholder="Ask a question about this data..."
        autocomplete="off"
        spellcheck="false"
        rows="1"
        required
      ></textarea>
      <button type="submit" class="dkan-aiq-submit">Ask</button>
    </div>
    <div class="dkan-aiq-footer">
      <div class="dkan-aiq-examples">
        <span class="dkan-aiq-examples-label">Try:</span>
        <button type="button" class="dkan-aiq-example" data-question="Show me the first 5 rows">First 5 rows</button>
        <button type="button" class="dkan-aiq-example" data-question="How many records are in this dataset?">Record count</button>
        <button type="button" class="dkan-aiq-example" data-question="Summarize this dataset">Summarize</button>
      </div>
      <div class="dkan-aiq-model-selector">
        <label for="dkan-aiq-model" class="dkan-aiq-model-label">Model:</label>
        <select id="dkan-aiq-model" class="dkan-aiq-model-select"></select>
      </div>
    </div>
  </form>

  <details class="dkan-aiq-debug">
    <summary class="dkan-aiq-debug-summary">Agent diagnostics</summary>
    <div class="dkan-aiq-debug-log"></div>
  </details>
  </div>
</div>
