{
  "name": "drupal/dkan_ai_query",
  "type": "drupal-module",
  "description": "Natural-language query for DKAN datasets, built on Drupal AI agents.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "drupal/dkan": "^4.1.0",
    "drupal/ai": "^1.3",
    "drupal/ai_agents": "^1.2",
    "drupal/key": "^1.20",
    "drupal/dkan_mcp_server": "^1.0.0-alpha3@alpha",
    "drupal/dkan_query_tools": "^1.0@alpha"
  },
  "suggest": {
    "drupal/ai_provider_anthropic": "Anthropic provider for the query agent (^1.2). One AI provider module with a configured key is required at runtime.",
    "drupal/ai_provider_openai": "OpenAI provider for the query agent (^1). One AI provider module with a configured key is required at runtime."
  },
  "require-dev": {
    "drupal/core": "^10.5 || ^11.2",
    "phpunit/phpunit": "^10 || ^11",
    "getdkan/mock-chain": "^1",
    "drush/drush": "^13"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Drupal\\dkan_ai_query\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\dkan_ai_query\\": "tests/src/"
    }
  },
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      },
      "file-mapping": {
        "[project-root]/.editorconfig": false,
        "[project-root]/.gitattributes": false,
        "[project-root]/recipes/README.txt": false
      }
    }
  },
  "config": {
    "allow-plugins": {
      "drupal/core-composer-scaffold": true,
      "cweagans/composer-patches": false
    }
  }
}
