{
  "name": "getdkan/dkan_drupal_ai_query",
  "type": "drupal-custom-module",
  "description": "Natural-language query for DKAN datasets, built on Drupal AI agents.",
  "require": {
    "drupal/ai": "^1.3",
    "drupal/ai_agents": "^1.2",
    "drupal/ai_provider_anthropic": "^1.2",
    "drupal/key": "^1.20"
  },
  "require-dev": {
    "drupal/core": "^10.2 || ^11",
    "phpunit/phpunit": "^9 || ^10",
    "getdkan/mock-chain": "^1"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "config": {
    "allow-plugins": {
      "drupal/core-composer-scaffold": false,
      "cweagans/composer-patches": false
    }
  }
}
